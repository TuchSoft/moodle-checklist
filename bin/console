#!/usr/bin/env php
<?php

ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL & ~E_DEPRECATED);

require_once __DIR__ . '/../vendor/autoload.php';
require_once __DIR__ . '/../vendor/squizlabs/php_codesniffer/autoload.php';

if (!defined('PHP_CODESNIFFER_VERBOSITY')) {
    define('PHP_CODESNIFFER_VERBOSITY', 0);
}
if (!defined('PHP_CODESNIFFER_CBF')) {
    define('PHP_CODESNIFFER_CBF', false);
}

use Symfony\Component\Console\Application;
use Tuchsoft\MoodleChecklist\Cli\CheckPluginCommand;
use Tuchsoft\MoodleChecklist\Cli\FixPluginCommand;
use Tuchsoft\IssueReporter\Command\ListFormat;

$application = new Application('Moodle Plugin Checker', '1.0.0');
$application->add(new CheckPluginCommand());
$application->add(new FixPluginCommand());
$application->add(new ListFormat());

// Symfony defaults --help with no command to the 'list' command help.
// We want the application overview instead.
if ($argc === 2 && in_array($argv[1], ['--help', '-h'], true)) {
    $output = new \Symfony\Component\Console\Output\ConsoleOutput();
    $application->setAutoExit(false);
    $application->run(new \Symfony\Component\Console\Input\ArrayInput(['command' => 'list']), $output);
    exit(0);
}

$application->run();

