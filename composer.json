{
    "name": "tuchsoft/moodle-checklist",
    "description": "Automated quality checks for Moodle plugins.",
    "license": "GPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Tuchsoft\\MoodleChecklist\\": "src/",
            "PHP_CodeSniffer\\": "vendor/squizlabs/php_codesniffer/src"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/Integration/"
        ]
    },
    "authors": [
        {
            "name": "Mattia Bonzi",
            "email": "mattia@tuchsoft.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/TuchSoft/issue-reporter.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/moodlehq/moodle-local_ci.git"
        },
        {
            "type": "package",
            "package": {
                "name": "moodlehq/moodle-local_moodlecheck",
                "version": "1.3.2",
                "source": {
                    "url": "https://github.com/moodlehq/moodle-local_moodlecheck.git",
                    "type": "git",
                    "reference": "v1.3.2"
                }
            }
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "ext-simplexml": "*",
        "ext-curl": "*",
        "ext-libxml": "*",
        "ext-dom": "*",
        "moodlehq/moodle-plugin-ci": "^4.5.11",
        "symfony/process": "^5.4",
        "squizlabs/php_codesniffer": "^3.13",
        "jasny/phpdoc-parser": "^1.0.1",
        "schlessera/markdown-escape": "dev-main",
        "ramsey/conventional-commits": "^1.4",
        "php-parallel-lint/php-parallel-lint": "^1.4.0",
        "phpmd/phpmd": "^2.13.0",
        "symfony/console": "^5.4",
        "symfony/serializer": "6.4.x-dev",
        "automattic/ignorefile": "^3.0@dev",
        "tuchsoft/issue-reporter": "dev-main",
        "intervention/image": "^3",
        "ext-gd": "*",
        "ext-exif": "*"

    },
    "scripts": {
        "install-python-deps": "php bin/install-python-deps.php",
        "post-autoload-dump": [
            "@install-python-deps",
            "npm i",
            "npm i --prefix ./vendor/moodlehq/moodle-local_ci"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
