{
    "name": "tuchsoft/moodle-checklist",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Tuchsoft\\MoodleChecklist\\": "src/",
            "PHP_CodeSniffer\\": "vendor/squizlabs/php_codesniffer/src"
        }
    },
    "authors": [
        {
            "name": "Mattia Bonzi",
            "email": "mattia@mattiabonzi.it"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-fileinfo": "*",
        "ext-simplexml": "*",
        "ext-curl": "*",
        "symfony/process": "^6.4",
        "squizlabs/php_codesniffer": "^3.13",
        "jasny/phpdoc-parser": "^1.0.1",
        "schlessera/markdown-escape": "dev-main",
        "ramsey/conventional-commits": "^1.4",
        "php-parallel-lint/php-parallel-lint": "^1.4.0",
        "phpmd/phpmd": "^2.15.0",
        "symfony/console": "^6.4",

    },
    "scripts": {
        "pre-update-cmd": [
            "mkdir -p xvendor",
            "[ ! -d \"xvendor/moodle-plugin-ci\" ] && composer -d xvendor create moodlehq/moodle-plugin-ci moodle-plugin-ci ^4 || true"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
